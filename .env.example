# Variable names only — no values in the repo.
# Local development loads Doris credentials from the file outside the repo:
#   set -a; source /home/ubuntu/AI-code/Doris-test/credentials.env; set +a
# which provides: DORIS_HOST DORIS_MYSQL_PORT DORIS_HTTP_PORT
#                 DORIS_ROOT_USER DORIS_ROOT_PASSWORD DORIS_RO_USER DORIS_RO_PASSWORD

# --- read by mcp-server/mcp_server.py (AgentCore Runtime envVars / local run) ---
DORIS_HOST=            # Runtime: 172.31.25.143 (private) · local: public IP
DORIS_PORT=9030
DORIS_HTTP_PORT=8030
DORIS_USER=            # mcp_svc (Runtime) · demo_ro (local P1)
DORIS_PASSWORD=        # local only; the Runtime uses DORIS_SECRET_ID instead
DORIS_SECRET_ID=       # Secrets Manager id, e.g. doris-mcp/mcp_svc  ({"username","password"})
PROFILE_SCOPE=all      # all | self   (decision D4)
DORIS_MCP_WORKSPACE_DIR=   # default: $TMPDIR/doris-mcp-workspace
MCP_PORT=8000

# --- scripts ---
GW_TOKEN=              # Gateway access token, from: export GW_TOKEN=$(bash scripts/get-gw-token.sh)
